{
  "name": "dsh-subagent-workbuddy",
  "version": "0.1.0",
  "description": "One-shot WorkBuddy (CodeBuddy CLI) subagent provider for DeepSeek Harness: a subagent_workbuddy delegation tool that runs the CLI bundled with WorkBuddy.app / @tencent-ai/codebuddy-code in the parent workspace.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib",
    "locale",
    "cordis.patch.yml",
    "icon.svg",
    "README.md"
  ],
  "license": "MIT",
  "icon": "./icon.svg",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "workbuddy",
    "codebuddy",
    "subagent",
    "delegation",
    "coding-agent"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/guihai24/dsh-plugins.git",
    "directory": "packages/dsh-subagent-workbuddy"
  },
  "homepage": "https://github.com/guihai24/dsh-plugins/tree/main/packages/dsh-subagent-workbuddy",
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.3.0-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
